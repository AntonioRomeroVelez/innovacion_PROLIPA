{"id":"tortuga-y-liebre","titulo":"La tortuga y la liebre","autor":"Fábula de Esopo","descripcion":"Una carrera muy desigual que enseña que la constancia vence a la prisa.","idioma":"es","portada":"imagenes/portada.svg","orden":2,"generado":"2026-10-05T14:27:40","personajes":{"narrador":{"nombre":"Narrador","emoji":"📖","color":"#2b8cf0","voz":"es-EC-LuisNeural"},"liebre":{"nombre":"Liebre","emoji":"🐇","color":"#d6336c","voz":"es-CO-GonzaloNeural"},"tortuga":{"nombre":"Tortuga","emoji":"🐢","color":"#1f9d55","voz":"es-PE-CamilaNeural"},"zorro":{"nombre":"Zorro","emoji":"🦊","color":"#d9730d","voz":"es-AR-TomasNeural"}},"paginas":[{"imagen":"imagenes/p1.svg","fondo":"","lineas":[{"personaje":"narrador","texto":"En un prado lleno de flores vivía una liebre muy presumida.","audio":"audio/narrador-279136a9d1.mp3","duracion":4776,"palabras":[["En",107,307],["un",322,465],["prado",479,779],["lleno",794,1108],["de",1123,1237],["flores",1251,1709],["vivía",1723,2109],["una",2124,2338],["liebre",2353,2753],["muy",2767,3010],["presumida.",3025,3769]]},{"personaje":"liebre","texto":"¡Soy la más veloz de todo el bosque! Nadie puede correr como yo.","audio":"audio/liebre-8d7cd4a8d1.mp3","duracion":4296,"palabras":[["¡Soy",95,296],["la",318,396],["más",418,541],["veloz",586,775],["de",809,876],["todo",932,1043],["el",1054,1099],["bosque!",1155,1512],["Nadie",2333,2600],["puede",2667,2790],["correr",2846,3069],["como",3114,3259],["yo.",3315,3460]]}]},{"imagen":"imagenes/p2.svg","fondo":"","lineas":[{"personaje":"tortuga","texto":"Yo creo que puedo ganarte una carrera.","audio":"audio/tortuga-67b0828364.mp3","duracion":3672,"palabras":[["Yo",108,341],["creo",356,691],["que",706,837],["puedo",851,1186],["ganarte",1201,1784],["una",1798,2060],["carrera.",2075,2658]]},{"personaje":"liebre","texto":"¡Ja, ja, ja! ¿Tú, la tortuga? ¡Si apenas caminas!","audio":"audio/liebre-29d51582e6.mp3","duracion":5496,"palabras":[["¡Ja,",96,263],["ja,",475,643],["ja!",844,1000],["¿Tú,",1864,2076],["la",2266,2355],["tortuga?",2411,2790],["¡Si",3619,3742],["apenas",3753,4099],["caminas!",4132,4657]]},{"personaje":"zorro","texto":"Muy bien, amigos. Yo seré el juez. La meta está al final del camino.","audio":"audio/zorro-b95a6dd11b.mp3","duracion":7104,"palabras":[["Muy",101,322],["bien,",348,674],["amigos.",817,1455],["Yo",2435,2643],["seré",2669,2917],["el",2917,2995],["juez.",3021,3437],["La",4414,4596],["meta",4635,4909],["está",4935,5143],["al",5156,5234],["final",5247,5534],["del",5586,5729],["camino.",5742,6159]]}]},{"imagen":"imagenes/p3.svg","fondo":"","lineas":[{"personaje":"zorro","texto":"¿Listas? ¡Uno, dos, tres, ya!","audio":"audio/zorro-b3e9673e7b.mp3","duracion":4896,"palabras":[["¿Listas?",101,726],["¡Uno,",1679,2056],["dos,",2356,2707],["tres,",2994,3397],["ya!",3593,3879]]},{"personaje":"narrador","texto":"La liebre salió disparada, y la tortuga empezó a caminar despacito, paso a paso.","audio":"audio/narrador-69c800d454.mp3","duracion":6864,"palabras":[["La",107,307],["liebre",322,694],["salió",708,1065],["disparada,",1080,1795],["y",2095,2210],["la",2224,2367],["tortuga",2381,2868],["empezó",2882,3311],["a",3325,3382],["caminar",3397,3883],["despacito,",3897,4670],["paso",4956,5313],["a",5327,5370],["paso.",5385,5857]]}]},{"imagen":"imagenes/p4.svg","fondo":"","lineas":[{"personaje":"liebre","texto":"Voy tan adelante que puedo dormir una siesta bajo este árbol.","audio":"audio/liebre-cd60ba1b7d.mp3","duracion":3264,"palabras":[["Voy",95,284],["tan",329,418],["adelante",429,764],["que",809,876],["puedo",943,1032],["dormir",1088,1266],["una",1266,1412],["siesta",1423,1735],["bajo",1802,1903],["este",1925,2126],["árbol.",2148,2461]]},{"personaje":"narrador","texto":"La liebre cerró los ojos y se quedó profundamente dormida, mientras la tortuga seguía y seguía sin detenerse.","audio":"audio/narrador-7473ffa2b1.mp3","duracion":8328,"palabras":[["La",107,307],["liebre",322,679],["cerró",694,1037],["los",1051,1280],["ojos",1294,1709],["y",1723,1795],["se",1809,1981],["quedó",1995,2295],["profundamente",2310,3154],["dormida,",3168,3711],["mientras",4098,4541],["la",4555,4655],["tortuga",4670,5184],["seguía",5199,5714],["y",5728,5799],["seguía",5814,6300],["sin",6314,6557],["detenerse.",6572,7330]]}]},{"imagen":"imagenes/p5.svg","fondo":"","lineas":[{"personaje":"narrador","texto":"Cuando la liebre despertó, vio a la tortuga cruzando la meta.","audio":"audio/narrador-85bfec7fa0.mp3","duracion":5112,"palabras":[["Cuando",107,436],["la",450,565],["liebre",579,937],["despertó,",951,1638],["vio",1995,2195],["a",2210,2238],["la",2252,2381],["tortuga",2396,2953],["cruzando",2968,3511],["la",3525,3640],["meta.",3654,4112]]},{"personaje":"liebre","texto":"¡No puede ser! ¡Perdí la carrera!","audio":"audio/liebre-be2c0b06b5.mp3","duracion":3120,"palabras":[["¡No",95,229],["puede",273,452],["ser!",452,664],["¡Perdí",1518,1752],["la",1786,1853],["carrera!",1908,2266]]},{"personaje":"zorro","texto":"¡La ganadora es la tortuga!","audio":"audio/zorro-56f8cf0a56.mp3","duracion":2664,"palabras":[["¡La",102,297],["ganadora",336,844],["es",922,1027],["la",1053,1144],["tortuga!",1209,1678]]}]},{"imagen":"imagenes/p6.svg","fondo":"","lineas":[{"personaje":"tortuga","texto":"Despacio, pero sin parar, también se llega lejos.","audio":"audio/tortuga-81e82ce6a8.mp3","duracion":5184,"palabras":[["Despacio,",108,822],["pero",1172,1361],["sin",1376,1609],["parar,",1623,2031],["también",2381,2920],["se",2935,3051],["llega",3066,3459],["lejos.",3474,4158]]},{"personaje":"narrador","texto":"Moraleja: la constancia vale más que la prisa.","audio":"audio/narrador-e0529b93c0.mp3","duracion":4344,"palabras":[["Moraleja:",107,779],["la",1151,1251],["constancia",1266,1952],["vale",1966,2252],["más",2267,2567],["que",2581,2710],["la",2724,2839],["prisa.",2853,3339]]}]}]}